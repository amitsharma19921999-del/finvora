# Finvora server configuration.
# Copy to `.env` and fill in to switch from free demo mode to real integrations.
# Every value is OPTIONAL — with none set, the app runs fully in free demo mode.

# ── Database ────────────────────────────────────────────────────
# Leave UNSET for local dev → uses an embedded Postgres (PGlite) at data/pgdata.
# Set to your Supabase (or any Postgres) connection string in production so data
# is permanent. Use Supabase's "Session pooler" URI (port 5432). See docs/SUPABASE_SETUP.md
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# ── Look & branding ─────────────────────────────────────────────
# Hide all demo scaffolding (the "Demo logins" box, demo hints) for a clean,
# production-looking UI — even while still using free demo SMS.
DEMO_HINTS=false
# BRAND_NAME=Your Brokerage

# ── Real market data (makes prices genuinely real, not simulated) ──
# sim   = built-in simulator (always lively, works offline; for demos)
# yahoo = REAL NSE last-traded prices + real intraday candles, free, no API key
#         (ticks during NSE hours 09:15–15:30 IST; shows last close otherwise)
FEED_MODE=yahoo

# ── Real SMS OTP (removes the on-screen OTP) — Twilio free trial ──
# SMS_MODE=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx

# ── Real payments (replaces the mock checkout) — Razorpay ─────────
# Test keys are free and take no real money; live keys need Razorpay KYC.
# GATEWAY_MODE=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ── Secrets (auto-generated to data/*.secret if left unset) ───────
# JWT_SECRET=set-a-long-random-string-for-multi-instance-deploys
# PORT=4000
